{
  "name": "sulaf",
  "version": "0.0.1",
  "private": true,
  "author": "Ebraheem Alhetari",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "fmt:check": "oxfmt --check --no-error-on-unmatched-pattern",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "check": "bun fmt && bun lint",
    "fix": "bun fmt && bun lint:fix",
    "prepare": "husky",
    "docs:dev": "bun --filter ./apps/www dev",
    "docs:build": "bun --filter ./apps/www build",
    "docs:preview": "bun --filter ./apps/www preview",
    "docs:generate": "bun --filter ./apps/www generate",
    "docs:postinstall": "bun --filter ./apps/www postinstall",
    "playground:dev": "bun --filter ./apps/playground dev",
    "playground:build": "bun --filter ./apps/playground build",
    "playground:preview": "bun --filter ./apps/playground preview",
    "registry:delete": "rm -rf ./apps/www/public/r",
    "registry:build": "bun registry:delete && bun --filter ./packages/registry build",
    "test": "bun --filter ./packages/registry test",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "1.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.11.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "~6.0.3"
  },
  "nano-staged": {
    "packages/registry/**/*": [
      "bun run registry:build",
      "git add apps/www/public/r"
    ],
    "*.{js,ts,vue}": [
      "bun fmt",
      "bun lint"
    ]
  },
  "packageManager": "bun@latest",
  "dependencies": {
    "nuxt-shiki": "0.3.2"
  }
}
